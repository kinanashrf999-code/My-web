*{box-sizing:border-box}
[hidden]{display:none !important}
html{scroll-behavior:smooth}
body{
  margin:0;min-height:100vh;background:#4b1626;color:var(--text);
  font-family:var(--sans);line-height:1.6;overflow-x:hidden;
}
#scene{position:fixed;inset:0;width:100%;height:100%;z-index:-2}
.scrim{position:fixed;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(28,8,12,.5) 0%,rgba(28,8,12,.2) 42%,rgba(28,8,12,.5) 100%)}
:focus-visible{outline:3px solid var(--sun-yellow);outline-offset:3px;border-radius:6px}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
 
/* top bar */
.topbar{
  position:sticky;top:0;z-index:10;direction:ltr;
  display:flex;align-items:center;justify-content:space-between;gap:1rem;
  padding:.65rem clamp(1rem,4vw,2.5rem);
  background:var(--glass);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
}
.clock{display:flex;flex-direction:column;line-height:1.1}
.clock-time{font-family:var(--serif);font-weight:600;font-size:clamp(1.7rem,4.5vw,2.4rem);font-variant-numeric:lining-nums tabular-nums;letter-spacing:.02em}
.clock-time .ampm{font-size:.5em;margin-inline-start:.4em;color:var(--sun-yellow);letter-spacing:.06em}
.clock-date{display:flex;flex-wrap:wrap;gap:.1rem .7rem;font-size:.82rem;color:var(--text-dim)}
.clock-date .tz{color:var(--sun-yellow);font-weight:600}
 
/* buttons */
.btn{
  font:inherit;font-weight:600;font-size:.95rem;min-height:44px;padding:.55rem 1.15rem;
  border-radius:999px;border:1px solid transparent;cursor:pointer;color:var(--text);background:transparent;
  display:inline-flex;align-items:center;justify-content:center;gap:.4rem;
}
.btn.primary{background:linear-gradient(90deg,var(--sun-yellow),var(--sun-orange));color:#2A0E10;font-weight:700}
.btn.primary:hover{filter:brightness(1.06)}
.btn.ghost{border-color:var(--line)}
.btn.ghost:hover{background:rgba(255,235,225,.08)}
.btn.accent{border-color:var(--sun-yellow);color:var(--sun-yellow)}
.btn.accent:hover{background:rgba(255,201,60,.12)}
.btn.danger{border-color:rgba(255,150,120,.55);color:#FFB8A4}
.btn.danger.armed{background:#B3261E;border-color:#B3261E;color:#fff}
.btn.sm{min-height:38px;padding:.3rem .9rem;font-size:.88rem}
.btn:disabled{opacity:.55;cursor:progress}
 
/* hero */
.wrap{max-width:1040px;margin:0 auto;padding:0 clamp(1rem,4vw,2rem) 5rem}
.hero{padding:clamp(2.2rem,8vw,5rem) 0 .6rem;direction:ltr}
.hero h1{font-family:var(--serif);font-weight:600;font-size:clamp(2.8rem,9vw,5.4rem);line-height:.98;margin:0;letter-spacing:.01em;text-shadow:0 2px 26px rgba(30,6,10,.75)}
.hero p{margin:.7rem 0 0;font-size:1.05rem;text-shadow:0 1px 12px rgba(30,6,10,.8)}
 
/* section titles */
.line-title{
  display:inline-flex;align-items:baseline;gap:.9rem;margin:2.2rem 0 1rem;padding:.3rem 1.1rem .35rem;
  background:var(--glass);border:1px solid var(--line);border-radius:999px;
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);direction:ltr;
}
.line-title h2{font-family:var(--serif);font-weight:600;font-size:1.55rem;line-height:1.2;margin:0}
.line-title span{font-size:.92rem;color:var(--sun-yellow);direction:rtl}
 
/* cards */
.card{
  display:flex;gap:1.5rem;direction:rtl;
  background:var(--card);border:1px solid var(--line);border-radius:18px;padding:1.1rem;margin:0 0 1.1rem;
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:0 12px 32px rgba(20,4,6,.35);
  scroll-margin-top:96px;
}
.card.flip{flex-direction:row-reverse}
.card-body{flex:1;min-width:0}
.name{font-family:var(--serif);font-weight:700;font-size:clamp(1.8rem,4.2vw,2.5rem);line-height:1.1;margin:.1rem 0 .7rem;direction:ltr;text-align:right}
.rows{margin:0}
.row{display:grid;grid-template-columns:9.6rem 1fr;gap:.15rem 1rem;padding:.55rem 0;border-top:1px solid rgba(255,201,60,.2)}
.row dt{color:var(--sun-yellow);font-weight:700;font-size:.92rem}
.row dd{margin:0;font-size:1rem}
.media{
  flex:0 0 clamp(150px,26%,230px);min-height:250px;border-radius:14px;overflow:hidden;position:relative;
  background:linear-gradient(165deg,#FFD65E 0%,#FF8A24 55%,#C2461C 100%);
  display:grid;place-items:center;
}
.media svg{width:78%;height:auto;max-height:270px;filter:drop-shadow(0 10px 12px rgba(60,10,5,.4))}
.media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.empty{padding:2rem;text-align:center;background:var(--card);border:1px solid var(--line);border-radius:18px;direction:ltr}
 
@media (max-width:680px){
  .card,.card.flip{flex-direction:column;gap:1rem}
  .media{order:-1;flex:none;min-height:220px;width:100%}
  .row{grid-template-columns:1fr}
}
 
/* control panel */
dialog{
  border:1px solid var(--line);border-radius:20px;padding:0;color:var(--text);
  background:linear-gradient(180deg,#3a1418,#2a0e12 45%);
  width:min(780px,calc(100vw - 1.5rem));max-height:calc(100dvh - 2rem);overflow:auto;direction:ltr;
}
dialog::backdrop{background:rgba(20,4,8,.68);backdrop-filter:blur(3px)}
.panel-in{padding:1.2rem 1.4rem 1.6rem}
.panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:.8rem}
.panel-head h2{font-family:var(--serif);font-size:1.9rem;font-weight:600;margin:0}
.icon-btn{font:inherit;font-size:1.6rem;line-height:1;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:transparent;color:var(--text);cursor:pointer}
.icon-btn:hover{background:rgba(255,235,225,.08)}
.tabs{display:flex;gap:.4rem;border-bottom:1px solid var(--line);margin-bottom:1.2rem}
.tabs button{
  font:inherit;font-weight:600;color:var(--text-dim);background:none;border:0;border-bottom:3px solid transparent;
  padding:.6rem .9rem;cursor:pointer;min-height:44px;
}
.tabs button[aria-selected="true"]{color:var(--sun-yellow);border-bottom-color:var(--sun-orange)}
.add-grid{display:grid;grid-template-columns:210px 1fr;gap:1.4rem}
.add-media{display:flex;flex-direction:column;gap:.7rem}
.preview{min-height:250px;width:100%}
.field{display:flex;flex-direction:column;gap:.3rem;margin-bottom:.9rem}
.field label,.field .lbl{font-size:.9rem;font-weight:600;color:var(--text-dim)}
.field input[type=text],.field textarea,.field select{
  font:inherit;color:var(--text);background:rgba(255,235,225,.08);border:1px solid var(--line);
  border-radius:10px;padding:.6rem .8rem;width:100%;
}
.field select option{background:#2A0E12;color:var(--text)}
.field textarea{resize:vertical;min-height:84px}
.field [lang=ar]{font-family:var(--sans);font-size:1rem}
.field input[type=color]{width:64px;height:42px;padding:2px;border-radius:10px;border:1px solid var(--line);background:transparent;cursor:pointer}
.name-row{display:flex;gap:.5rem}
.hint{margin:.1rem 0 0;font-size:.82rem;color:var(--text-dim);min-height:1.2em}
.file-btn:focus-within{outline:3px solid var(--sun-yellow);outline-offset:3px}
.actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.4rem}
@media (max-width:640px){
  .add-grid{grid-template-columns:1fr}
  .preview{min-height:210px}
}
 
.m-list{list-style:none;margin:0;padding:0;display:grid;gap:.6rem;outline:none}
.m-row{display:flex;align-items:center;gap:.9rem;padding:.55rem;border:1px solid var(--line);border-radius:14px;background:rgba(255,235,225,.05)}
.thumb{flex:0 0 56px;height:72px;border-radius:10px;overflow:hidden;position:relative;display:grid;place-items:center;background:linear-gradient(165deg,#FFD65E,#FF8A24 55%,#C2461C)}
.thumb svg{width:82%;height:auto}
.thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.m-info{flex:1;min-width:0;display:flex;flex-direction:column}
.m-info strong{font-family:var(--serif);font-size:1.25rem;line-height:1.2}
.m-info span{font-size:.82rem;color:var(--text-dim)}
.m-actions{display:flex;gap:.5rem;flex-wrap:wrap;justify-content:flex-end}
.m-foot{margin-top:1.3rem;padding-top:1rem;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;gap:.8rem;align-items:center;justify-content:space-between}
.m-foot p{margin:0;font-size:.85rem;color:var(--text-dim);max-width:42ch}
 
.toast{
  position:fixed;left:50%;bottom:1.4rem;transform:translate(-50%,20px);opacity:0;pointer-events:none;z-index:50;
  background:rgba(34,10,14,.94);border:1px solid var(--sun-yellow);color:var(--text);
  padding:.65rem 1.2rem;border-radius:999px;max-width:calc(100vw - 2rem);text-align:center;font-size:.95rem;
  transition:opacity .25s,transform .25s;
}
.toast.show{opacity:1;transform:translate(-50%,0)}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .toast{transition:none}
