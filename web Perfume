      list.append(el("li", { class: "m-row" },
        thumb,
        el("div", { class: "m-info" }, el("strong", { text: p.name }), el("span", { text: lineLabel(p) })),
        el("div", { class: "m-actions" },
          el("button", { class: "btn ghost sm", type: "button", text: "Edit", "aria-label": "Edit " + p.name, onclick: () => startEdit(p.id) }),
          del)));
    }
  }
  armed($("#restoreBtn"), "Restore original collection", "Confirm: replaces everything", () => {
    perfumes = JSON.parse(JSON.stringify(DEFAULTS));
    persist(); render(); renderManage();
    const b = $("#restoreBtn"); b.classList.remove("armed"); b.textContent = "Restore original collection";
    toast("Original collection restored.");
  });
 
  /* ---------- auto-fill with Claude ---------- */
  let sampleFn = null;
  function buildPrompt(name) {
    return `You are filling in an entry for a personal perfume collection app. The perfume is called "${name}".
Reply with only one JSON object with exactly these keys:
{"description": string, "season": string, "occasions": string, "smoke": string, "color": string, "line": string}
Rules:
- description, season, occasions and smoke are written in Arabic, one short sentence or phrase each, in the same warm style as this example for "Spanish Tobacco": description "مزيج فخم يجمع بين التبغ الإسباني، التوابل الدافئة، والتونكا مع لمسات فاكهية ناعمة.", season "الخريف، الشتاء، والربيع (ممتاز لدوام المدرسة والمشاوير اليومية).", occasions "الاجتماعات، الأيام الدراسية، واللقاءات الشبابية.", smoke "ممتاز جداً في امتصاص زناخة الدخان وتغطيتها بطابع دافئ وأنيق."
- description: the scent character and main notes. season: best seasons and time of day. occasions: suitable occasions such as weddings, business meetings, casual hangouts. smoke: how it performs next to cigarette smoke or vape smell (masks it, blends with it, or is best worn on clean skin).
- color: a muted hex color such as "#8B4A1C" that suits the liquid in the bottle.
- line: "Tobacco" if the name contains tobacco, "Diamond" if it contains diamond, otherwise "Other".
- If you do not recognise this exact perfume, infer from the name and keep the claims general. Do not invent specific notes.`;
  }
  function errorCopy(e) {
    switch (e && e.code) {
      case "cancelled": return "";
      case "not_granted": return "Auto-fill needs permission to use Claude. Press Auto-fill again and allow it.";
      case "rate_limited": return "Too many requests right now. Wait a moment, then try again.";
      case "session_expired": return "Your session expired. Sign in to Claude again, then retry.";
      case "invalid_json":
      case "empty_completion":
      case "refused": return "No suggestions came back for that name. Check the spelling or fill the fields yourself.";
      default: return "Auto-fill failed. Try again or fill the fields yourself.";
    }
  }
  $("#autofill").addEventListener("click", async () => {
    const name = f.name.value.trim();
    const status = $("#autoStatus");
    if (!name) { status.textContent = "Type the perfume name first."; f.name.focus(); return; }
    const btn = $("#autofill");
    btn.disabled = true;
    status.textContent = "Looking up " + name + "...";
    try {
      const d = await sampleFn.json(buildPrompt(name), { modelTier: "quick" });
      const s = v => (typeof v === "string" ? v.trim() : "");
      if (s(d.description)) f.desc.value = s(d.description);
      if (s(d.season)) f.season.value = s(d.season);
      if (s(d.occasions)) f.occ.value = s(d.occasions);
      if (s(d.smoke)) f.smoke.value = s(d.smoke);
      if (isHex(s(d.color))) f.color.value = s(d.color);
      if (LINES.some(l => l.key === d.line)) { f.line.value = d.line; lineTouched = true; }
      renderPreview();
      status.textContent = "Suggestions added from Claude's general knowledge. They can be wrong, so review them before saving.";
    } catch (e) {
      status.textContent = errorCopy(e);
    } finally {
      btn.disabled = false;
    }
  });
  (async function initSample() {
    try { sampleFn = (await (window.claude && window.claude.use ? window.claude.use("sample") : null)) || null; }
    catch (e) { sampleFn = null; }
    if (sampleFn) {
      $("#autofill").hidden = false;
      if (!$("#autoStatus").textContent) $("#autoStatus").textContent = "Auto-fill suggests the details from the name. Review them before saving.";
    }
  })();
 
  /* ---------- start ---------- */
  render();
  resetForm();
})();
</script>
</body>
